# ── Garmin Connect ────────────────────────────────────────────────────────────
# Your regular Garmin Connect login credentials
GARMIN_EMAIL=your_garmin_email@example.com
GARMIN_PASSWORD=your_garmin_password

# ── Groq API (free) ───────────────────────────────────────────────────────────
# Sign up at https://console.groq.com and generate a free key
GROQ_API_KEY=gsk_your_groq_api_key

# ── App ───────────────────────────────────────────────────────────────────────
# A long random string used to sign session cookies
SESSION_SECRET=change_this_to_a_long_random_string

# Public URL of your app (no trailing slash)
# Local dev:   http://localhost:3000
# Production:  https://your-app.railway.app
APP_URL=http://localhost:3000

PORT=3000

# ── Sync ──────────────────────────────────────────────────────────────────────
# How often to poll Garmin Connect for new activities (in minutes)
SYNC_INTERVAL_MINUTES=30

# How many days of history to fetch on first sync
INITIAL_SYNC_DAYS=90
